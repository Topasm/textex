{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TextEx",
  "version": "../package.json",
  "identifier": "com.topasm.textex",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:web",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../out/tauri-renderer",
    "removeUnusedCommands": true
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "TextEx",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": true,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#1e1e1e"
      }
    ],
    "security": {
      "capabilities": ["main-window"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob:; worker-src 'self' blob:;"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": ""
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/tectonic"],
    "resources": {
      "../resources/data/packages/**/*": "data/packages/",
      "../resources/licenses/**/*": "licenses/",
      "../resources/tectonic-cache/**/*": "tectonic-cache/"
    },
    "category": "Productivity",
    "shortDescription": "A local-first Tauri LaTeX editor",
    "longDescription": "TextEx is a Tauri-powered, local-first desktop LaTeX editor with a React editing shell and native Rust services.",
    "icon": ["../build/icon.png", "../build/icon.ico", "../build/icon.icns"]
  }
}
