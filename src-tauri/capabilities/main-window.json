{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Minimal capability for the local TextEx application window",
  "windows": ["main"],
  "permissions": [
    "allow-open-directory",
    "allow-open-file",
    "allow-read-directory",
    "allow-read-file",
    "allow-save-file",
    "allow-save-file-as",
    "allow-save-file-batch",
    "allow-create-file",
    "allow-create-directory",
    "allow-copy-file",
    "allow-rename-path",
    "allow-delete-path",
    "allow-read-file-base64",
    "allow-read-file-binary",
    "allow-git-is-repo",
    "allow-git-init",
    "allow-git-status",
    "allow-git-stage",
    "allow-git-unstage",
    "allow-git-commit",
    "allow-git-diff",
    "allow-git-log",
    "allow-git-file-log",
    "allow-load-package-data",
    "allow-watch-directory",
    "allow-unwatch-directory",
    "allow-load-settings",
    "allow-save-settings",
    "allow-activate-project",
    "allow-add-recent-project",
    "allow-remove-recent-project",
    "allow-update-recent-project",
    "allow-compile-latex",
    "allow-cancel-compile",
    "allow-check-app-update",
    "allow-download-and-install-update",
    "allow-restart-app"
  ]
}
