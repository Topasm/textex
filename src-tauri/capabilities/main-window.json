{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Minimal capability for the local TextEx application window",
  "windows": ["main"],
  "permissions": [
    "allow-open-directory",
    "allow-open-file",
    "allow-read-directory",
    "allow-read-file",
    "allow-save-file",
    "allow-save-file-as",
    "allow-save-file-batch",
    "allow-create-file",
    "allow-create-directory",
    "allow-copy-file",
    "allow-rename-path",
    "allow-delete-path",
    "allow-read-file-base64",
    "allow-read-file-binary",
    "allow-git-is-repo",
    "allow-git-init",
    "allow-git-status",
    "allow-git-stage",
    "allow-git-unstage",
    "allow-git-commit",
    "allow-git-diff",
    "allow-git-log",
    "allow-git-file-log",
    "allow-save-history-snapshot",
    "allow-get-history-list",
    "allow-load-history-snapshot",
    "allow-load-package-data",
    "allow-get-project-index",
    "allow-project-init",
    "allow-project-exists",
    "allow-project-load",
    "allow-project-save",
    "allow-project-touch",
