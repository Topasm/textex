{
  "name": "textex",
  "version": "1.2.6",
  "description": "A self-contained Tauri desktop LaTeX editor built with Rust, React, and Tectonic",
  "desktopName": "TextEx.desktop",
  "bin": {
    "textex": "./out/cli/cli/index.js"
  },
  "scripts": {
    "predev": "npm run setup:tauri",
    "dev": "tauri dev",
    "dev:web": "vite --config vite.config.ts",
    "prebuild": "npm run check:tauri-sidecars && npm run check:tectonic-cache-seed",
    "build": "tauri build --no-bundle",
    "build:web": "vite build --config vite.config.ts",
    "build:container": "bash scripts/tauri-linux-container.sh",
    "setup:tauri": "node scripts/setup-tauri-sidecars.js",
    "check:tauri-sidecars": "node scripts/setup-tauri-sidecars.js --check",
    "check:tectonic-cache-seed": "node scripts/prepare-tectonic-cache-seed.js --check",
    "check:release-version": "node scripts/check-release-version.js",
    "check:renderer-budget": "node scripts/check-renderer-performance-budget.js",
    "measure:renderer": "node scripts/measure-renderer-bundle.js",
    "measure:runtime": "node scripts/summarize-runtime-performance.js",
    "licenses:generate": "node scripts/generate-third-party-notices.js",
    "typecheck": "npm run typecheck:web && npm run typecheck:cli && npm run typecheck:mcp && npm run typecheck:tauri && npm run typecheck:test",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit --composite false --incremental false",
    "typecheck:cli": "tsc -p tsconfig.cli.json --noEmit --incremental false",
    "typecheck:mcp": "tsc -p tsconfig.mcp.json --noEmit --incremental false",
    "typecheck:tauri": "tsc -p tsconfig.tauri.json --noEmit --composite false --incremental false",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit --incremental false",
    "build:cli": "tsc -p tsconfig.cli.json",
    "build:mcp": "tsc -p tsconfig.mcp.json",
    "mcp": "node out/mcp/mcp/server.js",
    "prepreview": "npm run setup:tauri",
    "preview": "tauri dev --release --no-watch",
    "preview:web": "vite preview --config vite.config.ts",
    "prepackage": "npm run check:tauri-sidecars && npm run check:tectonic-cache-seed",
    "package": "tauri build",
    "prepackage:win": "node scripts/setup-tauri-sidecars.js --target x86_64-pc-windows-msvc --check && npm run check:tectonic-cache-seed",
    "package:win": "tauri build --bundles nsis --target x86_64-pc-windows-msvc",
    "prepackage:mac": "node scripts/setup-tauri-sidecars.js --target aarch64-apple-darwin --check && npm run check:tectonic-cache-seed",
    "package:mac": "tauri build --bundles dmg --target aarch64-apple-darwin",
    "prepackage:linux": "node scripts/setup-tauri-sidecars.js --target x86_64-unknown-linux-gnu --check && npm run check:tectonic-cache-seed",
    "package:linux": "tauri build --bundles appimage,deb --target x86_64-unknown-linux-gnu",
    "prepackage:linux:deb": "node scripts/setup-tauri-sidecars.js --target x86_64-unknown-linux-gnu --check && npm run check:tectonic-cache-seed",
    "package:linux:deb": "tauri build --bundles deb --target x86_64-unknown-linux-gnu",
    "package:linux:deb:container": "bash scripts/tauri-linux-container.sh bash -lc 'npm ci --ignore-scripts --include=optional && npm run setup:tauri && npm run package:linux:deb'",
    "prepackage:updater:win": "node scripts/setup-tauri-sidecars.js --target x86_64-pc-windows-msvc --check && npm run check:tectonic-cache-seed",
    "package:updater:win": "tauri build --config src-tauri/tauri.updater.conf.json --bundles nsis --target x86_64-pc-windows-msvc",
    "prepackage:updater:mac": "node scripts/setup-tauri-sidecars.js --target aarch64-apple-darwin --check && npm run check:tectonic-cache-seed",
    "package:updater:mac": "tauri build --config src-tauri/tauri.updater.conf.json --bundles dmg --target aarch64-apple-darwin",
    "prepackage:updater:linux": "node scripts/setup-tauri-sidecars.js --target x86_64-unknown-linux-gnu --check && npm run check:tectonic-cache-seed",
    "package:updater:linux": "tauri build --config src-tauri/tauri.updater.conf.json --bundles appimage,deb --target x86_64-unknown-linux-gnu",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "test": "vitest run && npm run test:scripts",
    "test:workflow": "vitest run src/__tests__/workflows",
    "test:scripts": "node --test scripts/*.test.js",
    "test:watch": "vitest",
    "check": "node scripts/quick-check.js",
    "pre-commit": "node scripts/pre-commit.js"
  },
  "keywords": [
    "latex",
    "editor",
    "tauri",
    "rust",
    "tectonic"
  ],
  "author": "Topasm <dhkdwk0215@naver.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2.11.1",
    "chokidar": "^5.0.0",
    "commander": "^14.0.3",
    "date-fns": "^4.4.0",
    "i18next": "^26.4.0",
    "katex": "^0.18.4",
    "lucide-react": "^1.34.0",
    "monaco-editor": "^0.56.0",
    "monaco-vim": "^0.4.4",
    "pdfjs-dist": "6.2.108",
    "prettier-plugin-latex": "^2.0.1",
    "react": "^19.2.8",
    "react-data-grid": "^7.0.0-beta.61",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "react-pdf": "^10.5.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.11.0",
    "jsdom": "^29.1.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.4.14"
    },
    "react-pdf": {
      "pdfjs-dist": "6.2.108"
    }
  }
}
