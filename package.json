{
  "name": "textex",
  "version": "1.0.8",
  "description": "A self-contained desktop LaTeX editor built on Electron",
  "desktopName": "TextEx.desktop",
  "main": "./out/main/main.js",
  "bin": {
    "textex": "./out/cli/cli/index.js"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "licenses:generate": "node scripts/generate-third-party-notices.js",
    "typecheck": "tsc --noEmit",
    "build:cli": "tsc -p tsconfig.cli.json",
    "build:mcp": "tsc -p tsconfig.mcp.json",
    "mcp": "node out/mcp/mcp/server.js",
    "preview": "electron-vite preview",
    "package:win": "electron-vite build && electron-builder --win",
    "package:mac": "electron-vite build && electron-builder --mac --arm64",
    "package:mac:x64": "electron-vite build && electron-builder --mac --x64",
    "package:mac:universal": "electron-vite build && electron-builder --mac --universal",
    "package:linux": "electron-vite build && electron-builder --linux",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "node scripts/quick-check.js",
    "pre-commit": "node scripts/pre-commit.js",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "latex",
    "editor",
    "electron",
    "tectonic"
  ],
  "author": "Topasm <dhkdwk0215@naver.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "adm-zip": "^0.6.0",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "date-fns": "^4.4.0",
    "electron-updater": "^6.8.9",
    "i18next": "^26.4.0",
    "katex": "^0.18.4",
    "lucide-react": "^1.33.0",
    "mathlive": "^0.110.0",
    "monaco-editor": "^0.56.0",
    "monaco-vim": "^0.4.4",
    "node-pty": "^1.1.0",
    "nspell": "^2.1.5",
    "pdfjs-dist": "6.2.108",
    "prettier-plugin-latex": "^2.0.1",
    "react": "^19.2.8",
    "react-data-grid": "^7.0.0-beta.61",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "react-pdf": "^10.5.0",
    "simple-git": "^3.36.0",
    "vscode-jsonrpc": "^9.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.1.4",
    "dictionary-en": "^4.0.0",
    "electron": "^41.10.6",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.11.0",
    "jsdom": "^29.1.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.4.14"
    },
    "react-pdf": {
      "pdfjs-dist": "6.2.108"
    }
  }
}
