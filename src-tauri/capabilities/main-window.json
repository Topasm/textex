    "allow-scan-labels",
    "allow-zotero-probe",
    "allow-zotero-search",
    "allow-zotero-cite-cayw",
    "allow-zotero-export-bibtex",
    "allow-zotero-sync-collection",
    "allow-watch-directory",
    "allow-unwatch-directory",
    "allow-load-settings",
    "allow-save-settings",
    "allow-activate-project",
    "allow-add-recent-project",
    "allow-remove-recent-project",
    "allow-update-recent-project",
    "allow-compile-latex",
    "allow-cancel-compile",
    "allow-synctex-forward",
    "allow-synctex-inverse",
